# Required: replace with your Okta custom authorization server issuer (not the org issuer).
OKTA_ISSUER_URI=https://your-org.okta.com/oauth2/default
# Must match that authorization server's API audience; api://default is common.
OKTA_AUDIENCE=api://default
DB_URL=jdbc:mysql://localhost:3306/runloyal
# For a locally installed MariaDB server, use jdbc:mariadb://localhost:3306/runloyal instead.
# Also set DB_MIGRATION_LOCATION=classpath:db/mariadb for MariaDB seed SQL.
# Run Maven from backend/ to load the optional local .env as plain NAME=value properties.
# Do not wrap values in quotes, use export statements, or include Markdown links.
DB_USER=runloyal
DB_PASSWORD=runloyal
