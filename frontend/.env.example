# ==============================================================================
# RunLoyal Admin Portal — Environment Configuration
# ==============================================================================

# Okta OIDC configuration (SPA authorization-code flow with PKCE).
# Never put a client secret in the browser. Create a public SPA application in Okta.
VITE_OKTA_ISSUER_URI=https://{yourOktaDomain}/oauth2/default
VITE_OKTA_CLIENT_ID={yourOktaSpaClientId}
VITE_OKTA_AUDIENCE=api://default

# Backend API URL (for local development, Vite proxies /api to this base)
VITE_API_BASE_URL=http://localhost:8080
