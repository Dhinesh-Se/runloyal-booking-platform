# ==============================================================================
# RunLoyal Admin Portal — Environment Configuration
# ==============================================================================

# Okta OIDC configuration (SPA authorization-code flow with PKCE).
# Never put a client secret in the browser.
# Required: replace placeholders with your custom authorization server and SPA ID.
# Org issuers (without /oauth2/{id}) and Auth0 URLs are not supported.
VITE_OKTA_ISSUER=https://your-okta-domain/oauth2/default
VITE_OKTA_CLIENT_ID=your_okta_spa_client_id
# Space-separated; append your API's custom scope if required by its policy.
VITE_OKTA_SCOPES=openid profile email
# Blank defaults to the current browser origin + /login/callback.
# Register that exact URL in Okta's Sign-in redirect URIs.
VITE_OKTA_REDIRECT_URI=
# Blank defaults to the current browser origin + / (recommended).
# Register that exact URL in Okta's Sign-out redirect URIs.
VITE_OKTA_LOGOUT_URI=

# Backend API URL (for local development, Vite proxies /api to this base)
VITE_API_BASE_URL=http://localhost:8080
